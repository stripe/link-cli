# Required: the server will not start until all three credentials are set.
# Register http://localhost:3000/api/auth/callback/link with Link.
LINK_CLIENT_ID=
LINK_CLIENT_SECRET=
LINK_REDIRECT_URI=
STRIPE_PUBLISHABLE_KEY=

# The example has a local-only default. Set this to use your own persistent secret.
# BETTER_AUTH_SECRET=

