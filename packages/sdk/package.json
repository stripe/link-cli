{
  "name": "@stripe/link-sdk",
  "version": "0.4.1",
  "description": "Node.js SDK for building agents that use Link",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stripe/link-cli.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/stripe/link-cli/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/stripe/link-cli/issues",
  "keywords": [
    "stripe",
    "link",
    "payments",
    "agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --noEmit false --emitDeclarationOnly",
    "prepack": "pnpm run build",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@stripe/link-typescript-config": "workspace:*",
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
