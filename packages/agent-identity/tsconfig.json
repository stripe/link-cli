{
  // Typechecks the library alone, without Node types, so a stray `Buffer` or
  // `node:crypto` import is a compile error rather than a portability surprise.
  "extends": "@stripe/link-typescript-config/base.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [],
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
