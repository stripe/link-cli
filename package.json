{
  "name": "@stripe/link-cli",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build && node scripts/sync-skill-version.js",
    "sync-skill-version": "node scripts/sync-skill-version.js",
    "dev": "turbo watch build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm run test:go",
    "test:go": "go -C packages/sdk-go test ./...",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "link-cli": "./packages/cli/dist/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^3.0.2",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "hono": "^4.13.7"
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
